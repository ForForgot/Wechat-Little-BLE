<view class="page page-bottom-safe">
  <view class="card">
    <view class="between">
      <view class="grow">
        <view class="title ellipsis">{{deviceName}}</view>
        <view class="subtitle mono ellipsis">{{deviceId}}</view>
      </view>
      <text class="badge {{connection === 'connected' ? 'badge-success' : (connection === 'connecting' ? 'badge-warn' : '')}}">{{connectionText}}</text>
    </view>
    <view class="row wrap gap16" style="margin-top:16rpx">
      <text class="muted">MTU {{mtu}}</text>
      <text wx:if="{{rssi}}" class="muted">RSSI {{rssi}}</text>
      <text class="muted">{{services.length}} 个服务</text>
    </view>
    <view class="row wrap gap8" style="margin-top:20rpx">
      <view class="btn btn-mini btn-primary" bindtap="bindMacroOpen">运行宏</view>
      <view class="btn btn-mini" bindtap="bindReconnect">重新连接</view>
      <view class="btn btn-mini btn-ghost" bindtap="gotoLibrary">调试库</view>
      <view class="btn btn-mini btn-ghost" bindtap="gotoLogs">日志</view>
      <view class="btn btn-mini btn-danger" bindtap="bindDisconnect">断开</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="state-bar state-bar-error">{{error}}</view>
  <view wx:if="{{loading}}" class="state-bar">
    <view class="row"><view class="spinner"></view><text>正在连接并枚举服务与特征值…</text></view>
  </view>

  <view class="section-title">数值显示格式</view>
  <view class="chips" style="padding-bottom:8rpx">
    <view wx:for="{{formats}}" wx:for-item="f" class="chip {{valueFormat === f ? 'chip-active' : ''}}" bindtap="bindValueFormat" data-format="{{f}}">{{f}}</view>
  </view>

  <view wx:if="{{!loading && services.length === 0 && !error}}" class="empty">
    <view class="empty-title">暂无服务</view>
    <view class="empty-desc">连接成功后会在此列出 GATT 服务与特征值</view>
  </view>

  <view wx:for="{{services}}" wx:for-item="svc" wx:for-index="si" wx:key="uuid" class="card card-flat">
    <view class="card-head" bindtap="bindServiceToggle" data-index="{{si}}">
      <view class="grow">
        <view class="row wrap gap8">
          <text class="title">{{svc.label}}</text>
          <text wx:if="{{svc.system}}" class="badge badge-warn">系统服务</text>
          <text wx:if="{{svc.isPrimary}}" class="badge badge-info">Primary</text>
        </view>
        <view class="tiny mono ellipsis" style="margin-top:6rpx">{{svc.uuid}}</view>
      </view>
      <view class="row" style="flex-shrink:0;margin-left:12rpx">
        <text class="muted">{{svc.expanded ? '收起' : '展开'}} · {{svc.loaded ? svc.chars.length : '…'}}</text>
        <view class="chevron" style="transform: rotate({{svc.expanded ? 135 : 45}}deg)"></view>
      </view>
    </view>

    <view wx:if="{{svc.expanded}}">
      <view wx:if="{{svc.error}}" class="state-bar state-bar-error">{{svc.error}}</view>
      <view wx:for="{{svc.chars}}" wx:for-item="c" wx:for-index="ci" wx:key="uuid" class="list-item">
        <view class="between">
          <view class="grow">
            <view class="strong ellipsis">{{c.label}}</view>
            <view class="tiny mono ellipsis">{{c.uuid}}</view>
          </view>
          <text wx:if="{{c.notifying}}" class="badge badge-success" style="flex-shrink:0">订阅中</text>
        </view>
        <view class="row wrap gap8" style="margin-top:12rpx">
          <text wx:for="{{c.propBadges}}" wx:for-item="p" class="badge {{p.cls}}">{{p.text}}</text>
        </view>
        <view wx:if="{{c.valueHex}}" class="value-box" style="margin-top:12rpx">
          <view class="mono">{{c.valueText}}</view>
          <view wx:if="{{c.parsed}}" class="muted" style="margin-top:6rpx">解析值：{{c.parsed}}</view>
        </view>
        <view class="row wrap gap8" style="margin-top:14rpx">
          <view wx:if="{{c.props.read}}" class="btn btn-mini" bindtap="bindRead" data-si="{{si}}" data-ci="{{ci}}">读取</view>
          <view wx:if="{{c.canNotify}}" class="btn btn-mini {{c.notifying ? 'btn-primary' : ''}}" bindtap="bindNotify" data-si="{{si}}" data-ci="{{ci}}">{{c.notifying ? '取消订阅' : '订阅'}}</view>
          <view wx:if="{{c.canWrite}}" class="btn btn-mini btn-ghost" bindtap="bindWriteOpen" data-si="{{si}}" data-ci="{{ci}}">写入</view>
        </view>
      </view>
      <view wx:if="{{svc.loaded && svc.chars.length === 0 && !svc.error}}" class="list-item muted">该服务下没有特征值</view>
    </view>
  </view>

  <view wx:if="{{recentLogs.length}}" class="card">
    <view class="between">
      <text class="title">最近通信</text>
      <text class="muted" bindtap="gotoLogs">查看全部</text>
    </view>
    <view wx:for="{{recentLogs}}" wx:for-item="log" class="row gap12" style="margin-top:12rpx">
      <text class="tiny mono" style="flex-shrink:0">{{log.time}}</text>
      <text class="grow muted ellipsis">{{log.title}} {{log.data}}</text>
    </view>
  </view>

  <view wx:if="{{showWritePanel || showMacroPanel}}" class="panel-mask" bindtap="bindClosePanels"></view>

  <view wx:if="{{showWritePanel}}" class="fixed-bottom fixed-bottom-safe">
    <view class="between" style="margin-bottom:12rpx">
      <text class="title ellipsis" style="max-width:440rpx">写入 · {{writeTargetLabel}}</text>
      <text class="muted" bindtap="bindWriteClose">关闭</text>
    </view>
    <view class="chips" style="padding:0 0 12rpx">
      <view wx:for="{{formats}}" wx:for-item="f" class="chip {{writeFormat === f ? 'chip-active' : ''}}" bindtap="bindWriteFormat" data-format="{{f}}">{{f}}</view>
    </view>
    <view wx:if="{{savedCommands.length}}" style="margin-bottom:12rpx">
      <view class="tiny">常用命令（点击填入）</view>
      <view class="chips" style="padding:8rpx 0 0">
        <view wx:for="{{savedCommands}}" wx:for-item="cmd" class="chip" bindtap="bindUseCommand" data-id="{{cmd.id}}">{{cmd.name}}</view>
      </view>
    </view>
    <input class="input" placeholder="{{writeFormat === 'HEX' ? '输入十六进制，如 01 02' : '输入内容'}}" value="{{writeText}}" bindinput="onWriteInput" />
    <view wx:if="{{writeTypeSupported}}" class="row gap8" style="margin-top:12rpx" bindtap="toggleWriteNoResponse">
      <text class="muted">无响应写入 writeNoResponse</text>
      <text class="badge {{writeNoResponse ? 'badge-info' : ''}}">{{writeNoResponse ? '开' : '关'}}</text>
    </view>
    <view class="row gap8" style="margin-top:16rpx">
      <view class="btn grow" bindtap="bindWriteClose">取消</view>
      <view class="btn grow" bindtap="bindSaveCommand">存为常用</view>
      <view class="btn btn-primary grow" bindtap="bindWriteSend">发送</view>
    </view>
  </view>

  <view wx:if="{{showMacroPanel}}" class="fixed-bottom fixed-bottom-safe">
    <view class="between" style="margin-bottom:12rpx">
      <text class="title">宏序列</text>
      <text class="muted" bindtap="bindMacroClose">关闭</text>
    </view>
    <view wx:if="{{macroTargetLabels.length}}" class="row gap8" style="margin-bottom:12rpx">
      <text class="muted" style="flex-shrink:0">目标特征值</text>
      <picker mode="selector" range="{{macroTargetLabels}}" value="{{macroTargetIndex}}" bindchange="onMacroTargetChange" class="grow">
        <view class="input ellipsis">{{macroTargetLabel || '请选择'}}</view>
      </picker>
    </view>
    <view wx:else class="state-bar state-bar-warn">尚未读取到特征值，请先连接设备并等待服务枚举完成</view>
    <view wx:if="{{macroProgress}}" class="state-bar">{{macroProgress}}</view>
    <view wx:if="{{macroList.length === 0}}" class="empty" style="padding:40rpx">
      <view class="empty-desc">还没有宏，去「调试库」创建</view>
    </view>
    <view wx:for="{{macroList}}" wx:key="id" class="row gap12" style="padding:14rpx 0;border-bottom:1rpx solid #EDF0F4">
      <view class="grow">
        <text class="strong">{{item.name}}</text>
        <text class="muted"> · {{item.stepCount}} 步</text>
      </view>
      <view class="btn btn-mini btn-primary" bindtap="bindMacroRun" data-id="{{item.id}}">{{macroRunning ? '运行中' : '运行'}}</view>
    </view>
    <view class="row gap12" style="margin-top:16rpx">
      <view class="btn grow" bindtap="gotoLibrary">管理宏</view>
      <view class="btn btn-danger grow" bindtap="bindMacroStop">停止</view>
    </view>
  </view>
</view>
