.card-head { padding: 22rpx 24rpx; }
.list-item { padding: 22rpx 24rpx; }
.list-item .ellipsis { max-width: 480rpx; }
.value-box { line-height: 1.7; }
.badge { margin-right: 8rpx; }
.chip { padding: 8rpx 20rpx; }
.macro-row { padding: 14rpx 0; border-bottom: 1rpx solid #EDF0F4; }

@media (prefers-color-scheme: dark) {
  .macro-row { border-bottom-color: #262D36; }
}
