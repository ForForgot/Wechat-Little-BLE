{
  "pages": [
    "pages/scan/scan",
    "pages/conn/conn",
    "pages/signal/signal",
    "pages/library/library",
    "pages/help/help",
    "pages/logs/logs",
    "pages/settings/settings"
  ],
  "window": {
    "backgroundTextStyle": "@bgText",
    "backgroundColor": "@bg",
    "navigationBarBackgroundColor": "@navBg",
    "navigationBarTitleText": "BLE 调试工具",
    "navigationBarTextStyle": "@navText",
    "enablePullDownRefresh": false
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelected",
    "backgroundColor": "@tabBg",
    "borderStyle": "@tabBorder",
    "list": [
      {
        "pagePath": "pages/scan/scan",
        "text": "扫描",
        "iconPath": "@scanIcon",
        "selectedIconPath": "@scanActive"
      },
      {
        "pagePath": "pages/library/library",
        "text": "调试库",
        "iconPath": "@libraryIcon",
        "selectedIconPath": "@libraryActive"
      },
      {
        "pagePath": "pages/logs/logs",
        "text": "日志",
        "iconPath": "@logsIcon",
        "selectedIconPath": "@logsActive"
      },
      {
        "pagePath": "pages/settings/settings",
        "text": "设置",
        "iconPath": "@settingsIcon",
        "selectedIconPath": "@settingsActive"
      }
    ]
  },
  "permission": {
    "scope.userLocation": {
      "desc": "蓝牙扫描需要定位权限，用于发现附近的低功耗蓝牙设备"
    }
  },
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "darkmode": true,
  "themeLocation": "theme.json",
  "sitemapLocation": "sitemap.json"
}
